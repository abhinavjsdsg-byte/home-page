# Supabase project URL — Project Settings > API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# SERVER ONLY. Never put this value in contact.html or any public JS.
# Use the service_role secret from Supabase Project Settings > API.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Port for the Node API
PORT=3000

# Optional: comma-separated allowed browser origins.
# Example: https://markgroups.in,https://www.markgroups.in,http://localhost:3000
# Leave blank during local testing if the page is served by this same Express server.
ALLOWED_ORIGINS=
